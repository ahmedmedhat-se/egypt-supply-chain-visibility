# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=escv_db
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# pgAdmin
PGADMIN_EMAIL=admin@escv.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# OSRM (self-hosted routing, built & imported via ./osrm Dockerfile)
OSRM_PORT=5000
